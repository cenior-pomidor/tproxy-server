@@ -0,0 +1,199 @@
+/*
+ * This is the source code of Telegram for Android v. 5.x.x.
+ * It is licensed under GNU GPL v. 2 or later.
+ * You should have received a copy of the license in this archive (see LICENSE).
+ *
+ * WEB proxy protocol v1 frame codec, see PROTOCOL.md of the relay project.
+ */
+
+package org.telegram.messenger;
+
+import java.util.ArrayList;
+import java.util.List;
+
+public final class WebProxyFrame {
+
+    public static final int HEADER_SIZE = 8;
+    public static final int MAX_PAYLOAD = 1024 * 1024;
+    public static final int DATA_CHUNK = 64 * 1024;
+    public static final int INITIAL_WINDOW = 4 * 1024 * 1024;
+    public static final int MAX_STREAM_ID = 0xFFFFFF;
+    public static final int MAX_BATCH_FRAMES = 4096;
+
+    public static final int TYPE_OPEN = 0x01;
+    public static final int TYPE_DATA = 0x02;
+    public static final int TYPE_CLOSE = 0x03;
+    public static final int TYPE_WINDOW = 0x04;
+    public static final int TYPE_PING = 0x05;
+    public static final int TYPE_PONG = 0x06;
+    public static final int TYPE_HELLO = 0x10;
+    public static final int TYPE_WELCOME = 0x11;
+    public static final int TYPE_BYE = 0x1f;
+
+    public static class InvalidFrameException extends Exception {
+        public InvalidFrameException(String message) {
+            super(message);
+        }
+    }
+
+    public final int type;
+    public final int streamId;
+    public final byte[] payload;
+
+    private WebProxyFrame(int type, int streamId, byte[] payload) {
+        this.type = type;
+        this.streamId = streamId;
+        this.payload = payload;
+    }
+
+    public static byte[] encode(int type, int streamId, byte[] payload, int offset, int length) {
+        if (streamId < 0 || streamId > MAX_STREAM_ID) {
+            throw new IllegalArgumentException("stream id exceeds 24 bits");
+        }
+        if (length < 0 || length > MAX_PAYLOAD) {
+            throw new IllegalArgumentException("payload exceeds the frame limit");
+        }
+        byte[] result = new byte[HEADER_SIZE + length];
+        result[0] = (byte) type;
+        result[1] = (byte) (streamId >> 16);
+        result[2] = (byte) (streamId >> 8);
+        result[3] = (byte) streamId;
+        result[4] = (byte) (length >>> 24);
+        result[5] = (byte) (length >>> 16);
+        result[6] = (byte) (length >>> 8);
+        result[7] = (byte) length;
+        if (length != 0) {
+            System.arraycopy(payload, offset, result, HEADER_SIZE, length);
+        }
+        return result;
+    }
+
+    public static byte[] hello() {
+        return encode(TYPE_HELLO, 0, new byte[]{1}, 0, 1);
+    }
+
+    public static byte[] open(int streamId) {
+        return encode(TYPE_OPEN, streamId, null, 0, 0);
+    }
+
+    public static byte[] close(int streamId) {
+        return encode(TYPE_CLOSE, streamId, null, 0, 0);
+    }
+
+    public static byte[] data(int streamId, byte[] payload, int offset, int length) {
+        if (length <= 0) {
+            throw new IllegalArgumentException("DATA payload must be nonempty");
+        }
+        return encode(TYPE_DATA, streamId, payload, offset, length);
+    }
+
+    public static byte[] window(int streamId, long delta) {
+        if (delta <= 0 || delta > 0xFFFFFFFFL) {
+            throw new IllegalArgumentException("WINDOW delta must be a nonzero u32");
+        }
+        byte[] payload = new byte[]{
+                (byte) (delta >>> 24),
+                (byte) (delta >>> 16),
+                (byte) (delta >>> 8),
+                (byte) delta
+        };
+        return encode(TYPE_WINDOW, streamId, payload, 0, payload.length);
+    }
+
+    public static byte[] pong(byte[] token) {
+        return encode(TYPE_PONG, 0, token, 0, token.length);
+    }
+
+    public long windowAmount() throws InvalidFrameException {
+        if (payload.length != 4) {
+            throw new InvalidFrameException("WINDOW payload must be four bytes");
+        }
+        long value = ((long) (payload[0] & 0xff) << 24)
+                | ((payload[1] & 0xff) << 16)
+                | ((payload[2] & 0xff) << 8)
+                | (payload[3] & 0xff);
+        if (value == 0) {
+            throw new InvalidFrameException("WINDOW delta must be nonzero");
+        }
+        return value;
+    }
+
+    /**
+     * Parses a complete relay-to-client frame batch. The bridge normally delivers exactly one
+     * frame per message, but a batch stays valid input.
+     */
+    public static List<WebProxyFrame> parseAll(byte[] input) throws InvalidFrameException {
+        List<WebProxyFrame> frames = new ArrayList<>(1);
+        int offset = 0;
+        while (offset != input.length) {
+            if (frames.size() == MAX_BATCH_FRAMES) {
+                throw new InvalidFrameException("frame batch contains too many frames");
+            }
+            if (input.length - offset < HEADER_SIZE) {
+                throw new InvalidFrameException("incomplete frame");
+            }
+            long length = ((long) (input[offset + 4] & 0xff) << 24)
+                    | ((input[offset + 5] & 0xff) << 16)
+                    | ((input[offset + 6] & 0xff) << 8)
+                    | (input[offset + 7] & 0xff);
+            if (length > MAX_PAYLOAD) {
+                throw new InvalidFrameException("frame payload exceeds limit");
+            }
+            if (length > input.length - offset - HEADER_SIZE) {
+                throw new InvalidFrameException("incomplete frame");
+            }
+            int type = input[offset] & 0xff;
+            int streamId = ((input[offset + 1] & 0xff) << 16)
+                    | ((input[offset + 2] & 0xff) << 8)
+                    | (input[offset + 3] & 0xff);
+            byte[] payload = new byte[(int) length];
+            System.arraycopy(input, offset + HEADER_SIZE, payload, 0, payload.length);
+            WebProxyFrame frame = new WebProxyFrame(type, streamId, payload);
+            frame.validateRelayShape();
+            frames.add(frame);
+            offset += HEADER_SIZE + payload.length;
+        }
+        if (frames.isEmpty()) {
+            throw new InvalidFrameException("empty frame batch");
+        }
+        return frames;
+    }
+
+    private void validateRelayShape() throws InvalidFrameException {
+        if (streamId == 0) {
+            switch (type) {
+                case TYPE_WELCOME:
+                    if (payload.length != 0) {
+                        throw new InvalidFrameException("WELCOME requires an empty payload");
+                    }
+                    return;
+                case TYPE_PING:
+                    if (payload.length > 64) {
+                        throw new InvalidFrameException("PING token is too long");
+                    }
+                    return;
+                case TYPE_BYE:
+                    return;
+                default:
+                    throw new InvalidFrameException("frame type " + type + " is invalid on stream zero");
+            }
+        }
+        switch (type) {
+            case TYPE_CLOSE:
+                if (payload.length != 0) {
+                    throw new InvalidFrameException("CLOSE requires an empty payload");
+                }
+                return;
+            case TYPE_DATA:
+                if (payload.length == 0) {
+                    throw new InvalidFrameException("DATA payload must be nonempty");
+                }
+                return;
+            case TYPE_WINDOW:
+                windowAmount();
+                return;
+            default:
+                throw new InvalidFrameException("frame type " + type + " is invalid relay-to-client");
+        }
+    }
+}
