+    // endregion
+
+    /**
+     * Runs before provider JavaScript. It installs a second CSP that does not depend on the
+     * response headers and replaces the browser facilities the bridge never uses with
+     * nonreplaceable unavailable shims. The CSP and the native policy remain the boundary.
+     */
+    private static String hardeningScript(String allowedOrigin) {
+        String csp = "default-src 'none'; base-uri 'none'; child-src 'none'; connect-src "
+                + allowedOrigin + " " + allowedOrigin.replaceFirst("^https:", "wss:")
+                + "; font-src 'none'; form-action 'none'; frame-src 'none'; img-src 'none';"
+                + " manifest-src 'none'; media-src 'none'; object-src 'none'; script-src 'unsafe-inline';"
+                + " style-src 'none'; worker-src 'none'";
+        return "(function(){'use strict';\n"
+                + "var root=document.documentElement;\n"
+                + "var head=document.head;\n"
+                + "if(!head){head=document.createElement('head');root.insertBefore(head,root.firstChild);}\n"
+                + "function meta(name,value,http){var node=document.createElement('meta');"
+                + "node.setAttribute(http?'http-equiv':'name',name);node.setAttribute('content',value);"
+                + "head.insertBefore(node,head.firstChild);}\n"
+                + "meta('x-dns-prefetch-control','off',true);\n"
+                + "meta('Content-Security-Policy'," + quote(csp) + ",true);\n"
+                + "function unavailable(){throw new Error('unavailable');}\n"
+                + "function deny(target,name,value){try{Object.defineProperty(target,name,"
+                + "{configurable:false,enumerable:false,writable:false,value:value});}catch(e){}}\n"
+                + "function denyGetter(target,name){try{Object.defineProperty(target,name,"
+                + "{configurable:false,enumerable:false,get:unavailable,set:function(){}});}catch(e){}}\n"
+                + "var storage=['localStorage','sessionStorage','indexedDB','caches','openDatabase',"
+                + "'webkitStorageInfo','webkitIndexedDB'];\n"
+                + "for(var a=0;a<storage.length;a++){denyGetter(window,storage[a]);}\n"
+                + "var constructors=['Worker','SharedWorker','BroadcastChannel','Audio','AudioContext',"
+                + "'webkitAudioContext','RTCPeerConnection','webkitRTCPeerConnection','SpeechSynthesisUtterance'];\n"
+                + "for(var b=0;b<constructors.length;b++){deny(window,constructors[b],unavailable);}\n"
+                + "deny(window,'open',function(){return null;});\n"
+                + "var inert=['print','alert','confirm','prompt'];\n"
+                + "for(var c=0;c<inert.length;c++){deny(window,inert[c],function(){});}\n"
+                + "var navigatorKeys=['serviceWorker','clipboard','mediaDevices','geolocation','bluetooth',"
+                + "'usb','serial','hid','credentials','storage','wakeLock','share','xr'];\n"
+                + "for(var d=0;d<navigatorKeys.length;d++){denyGetter(navigator,navigatorKeys[d]);}\n"
+                + "try{Object.defineProperty(document,'cookie',{configurable:false,enumerable:false,"
+                + "get:function(){return '';},set:function(){}});}catch(e){}\n"
+                + "})();";
+    }
+
+    private static String quote(String value) {
+        StringBuilder builder = new StringBuilder(value.length() + 2);
+        builder.append('\'');
+        for (int a = 0; a < value.length(); a++) {
+            char character = value.charAt(a);
+            if (character == '\'' || character == '\\') {
+                builder.append('\\');
+            }
+            builder.append(character);
+        }
+        builder.append('\'');
+        return builder.toString();
+    }
+}
