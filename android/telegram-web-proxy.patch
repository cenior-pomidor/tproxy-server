+            });
+            view.setNetworkAvailable(true);
+            WebViewCompat.addDocumentStartJavaScript(view, hardeningScript(allowedOrigin), Collections.singleton(allowedOrigin));
+            WebViewCompat.addWebMessageListener(view, JS_OBJECT_NAME, Collections.singleton(allowedOrigin),
+                    new CarrierMessageListener(carrierGeneration, allowedOrigin));
+        } catch (Throwable e) {
+            FileLog.e(e);
+            synchronized (lock) {
+                carrierUsable = false;
+                state = STATE_UNSUPPORTED;
+            }
+            closeAllStreams();
+            return;
+        }
+        synchronized (lock) {
+            if (!running || generation != carrierGeneration) {
+                view.destroy();
+                return;
+            }
+            webView = view;
+        }
+        view.loadUrl(url);
+    }
+
+    private void destroyCarrier() {
+        WebView view;
+        synchronized (lock) {
+            view = webView;
+            webView = null;
+            replyProxy = null;
+            carrierReady = false;
+        }
+        if (view == null) {
+            return;
+        }
+        try {
+            view.stopLoading();
+            view.loadUrl("about:blank");
+            view.setWebViewClient(new WebViewClient());
+            view.setWebChromeClient(null);
+            if (WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) {
+                WebViewCompat.removeWebMessageListener(view, JS_OBJECT_NAME);
+            }
+            view.clearHistory();
+            view.clearCache(true);
+            view.clearFormData();
+            view.destroy();
+        } catch (Throwable e) {
+            FileLog.e(e);
+        }
+    }
+
+    private void failCarrier(String reason) {
+        synchronized (lock) {
+            failCarrierLocked(reason);
+        }
+    }
+
+    private void failCarrierLocked(String reason) {
+        if (!running || !carrierUsable) {
+            return;
+        }
+        if (BuildVars.LOGS_ENABLED) {
+            FileLog.d("web proxy: carrier failed, " + reason);
+        }
+        carrierReady = false;
+        replyProxy = null;
+        outbound.clear();
+        outboundCharge = 0;
+        state = STATE_RECONNECTING;
+        generation++;
+        long delay = retryDelay;
+        retryDelay = Math.min(retryDelay * 2, RETRY_MAX_DELAY);
+        uiHandler.post(() -> {
+            destroyCarrier();
+            closeAllStreams();
+        });
+        uiHandler.postDelayed(new RetryCarrier(), delay);
+    }
+
+    private final class RetryCarrier implements Runnable {
+
+        @Override
+        public void run() {
+            synchronized (lock) {
+                if (!running || !carrierUsable || webView != null) {
+                    return;
+                }
+            }
+            // The carrier is foreground scoped: a WebView created while Telegram is backgrounded
+            // may be throttled or killed straight away, so wait for the next foreground transition.
+            if (ApplicationLoader.mainInterfacePaused) {
+                uiHandler.postDelayed(this, FOREGROUND_POLL_DELAY);
+                return;
+            }
+            createCarrier();
+        }
+    }
+
+    private void scheduleWatchdog() {
+        synchronized (lock) {
+            if (watchdogScheduled) {
+                return;
+            }
+            watchdogScheduled = true;
+        }
+        uiHandler.postDelayed(this::watchdog, WATCHDOG_INTERVAL);
+    }
+
+    private void watchdog() {
+        synchronized (lock) {
+            watchdogScheduled = false;
+            if (!running) {
+                return;
+            }
+            if (carrierUsable && webView != null) {
+                long now = System.currentTimeMillis();
+                if (!carrierReady && now - carrierStartedAt > HANDSHAKE_TIMEOUT) {
+                    failCarrierLocked("bridge handshake timed out");
+                } else if (carrierReady && !outbound.isEmpty() && now - lastCarrierActivity > CARRIER_IDLE_TIMEOUT) {
+                    failCarrierLocked("bridge stopped acknowledging traffic");
+                }
+            }
+            watchdogScheduled = true;
+        }
+        uiHandler.postDelayed(this::watchdog, WATCHDOG_INTERVAL);
+    }
+
+    // endregion
+
+    // region webview boundary
+
+    private final class CarrierMessageListener implements WebViewCompat.WebMessageListener {
+
+        private final int carrierGeneration;
+        private final String allowedOrigin;
+
+        private CarrierMessageListener(int carrierGeneration, String allowedOrigin) {
+            this.carrierGeneration = carrierGeneration;
+            this.allowedOrigin = allowedOrigin;
+        }
+
+        @Override
+        public void onPostMessage(@NonNull WebView view, @NonNull WebMessageCompat message, @NonNull Uri sourceOrigin,
+                                  boolean isMainFrame, @NonNull JavaScriptReplyProxy proxy) {
+            if (!isMainFrame || !allowedOrigin.equals(sourceOrigin.toString())) {
+                return;
+            }
+            synchronized (lock) {
+                if (!running || generation != carrierGeneration || webView != view) {
+                    return;
+                }
+                lastCarrierActivity = System.currentTimeMillis();
+            }
+            try {
+                if (message.getType() == WebMessageCompat.TYPE_ARRAY_BUFFER) {
+                    onCarrierFrames(carrierGeneration, message.getArrayBuffer());
+                } else {
+                    onCarrierControl(carrierGeneration, message.getData(), proxy);
+                }
+            } catch (Throwable e) {
+                FileLog.e(e);
+                failCarrier("invalid bridge message");
+            }
+        }
+    }
+
+    private void onCarrierControl(int carrierGeneration, String value, JavaScriptReplyProxy proxy) {
+        if (value == null) {
+            return;
+        }
+        JSONObject object;
+        try {
+            object = new JSONObject(value);
+        } catch (Exception e) {
+            failCarrier("malformed bridge control value");
+            return;
+        }
+        String type = object.optString("t");
+        if (INIT_MESSAGE.equals(type)) {
+            byte[] hello;
+            synchronized (lock) {
+                if (!running || generation != carrierGeneration || replyProxy != null) {
+                    return;
+                }
+                if (object.optInt("v") != 1 || !equalsConstantTime(nonce, object.optString("nonce"))) {
+                    failCarrierLocked("bridge presented an invalid nonce");
+                    return;
+                }
+                replyProxy = proxy;
+                hello = WebProxyFrame.hello();
+            }
+            // HELLO is the bootstrap message: it starts the relay session behind the bridge.
+            try {
+                proxy.postMessage(hello);
+            } catch (Throwable e) {
+                FileLog.e(e);
+                failCarrier("bridge rejected HELLO");
+            }
+        } else if ("status".equals(type)) {
+            String reported = object.optString("state");
+            synchronized (lock) {
+                if (!running || generation != carrierGeneration) {
+                    return;
+                }
+                if ("failed".equals(reported)) {
+                    failCarrierLocked("bridge reported a carrier failure");
+                } else if ("reconnecting".equals(reported) && state == STATE_CONNECTED) {
+                    state = STATE_RECONNECTING;
+                } else if ("connected".equals(reported) && carrierReady) {
+                    state = STATE_CONNECTED;
+                }
+            }
+        } else if ("traffic".equals(type)) {
+            synchronized (lock) {
+                downlinkBytes += Math.max(0, object.optLong("down"));
+            }
+        } else if ("close".equals(type)) {
+            failCarrier("bridge closed the carrier");
+        }
+    }
+
+    private void onCarrierFrames(int carrierGeneration, byte[] value) {
+        if (value == null || value.length == 0) {
+            failCarrier("empty bridge message");
+            return;
+        }
+        java.util.List<WebProxyFrame> frames;
+        try {
+            frames = WebProxyFrame.parseAll(value);
+        } catch (WebProxyFrame.InvalidFrameException e) {
+            failCarrier(e.getMessage());
+            return;
+        }
+        for (int a = 0; a < frames.size(); a++) {
+            WebProxyFrame frame = frames.get(a);
+            if (frame.streamId == 0) {
+                if (frame.type == WebProxyFrame.TYPE_WELCOME) {
+                    boolean flushNow = false;
+                    synchronized (lock) {
+                        if (!running || generation != carrierGeneration || carrierReady) {
+                            continue;
+                        }
+                        carrierReady = true;
+                        state = STATE_CONNECTED;
+                        retryDelay = RETRY_MIN_DELAY;
+                        scheduleFlushLocked();
+                        flushNow = true;
+                    }
+                    if (flushNow && BuildVars.LOGS_ENABLED) {
+                        FileLog.d("web proxy: carrier session established");
+                    }
+                } else if (frame.type == WebProxyFrame.TYPE_PING) {
+                    enqueue(WebProxyFrame.pong(frame.payload));
+                } else if (frame.type == WebProxyFrame.TYPE_BYE) {
+                    failCarrier("relay closed the session");
+                    return;
+                }
+                continue;
+            }
+            Stream stream;
+            synchronized (lock) {
+                if (!running || generation != carrierGeneration) {
+                    return;
+                }
+                if (!carrierReady) {
+                    failCarrierLocked("stream frame before WELCOME");
+                    return;
+                }
+                stream = streams.get(frame.streamId);
+            }
+            if (stream == null) {
+                // A closed stream may still receive well formed late frames, drop them.
+                continue;
+            }
+            switch (frame.type) {
+                case WebProxyFrame.TYPE_DATA:
+                    stream.deliver(frame.payload);
+                    break;
+                case WebProxyFrame.TYPE_WINDOW:
+                    try {
+                        stream.grantCredit(frame.windowAmount());
+                    } catch (WebProxyFrame.InvalidFrameException e) {
+                        failCarrier(e.getMessage());
+                        return;
+                    }
+                    break;
+                case WebProxyFrame.TYPE_CLOSE:
+                    closeStream(frame.streamId, carrierGeneration, false);
+                    break;
+                default:
+                    break;
+            }
+        }
+    }
+
+    private static boolean equalsConstantTime(String expected, String value) {
+        if (expected == null || value == null || expected.length() != value.length()) {
+            return false;
+        }
+        int difference = 0;
+        for (int a = 0; a < expected.length(); a++) {
+            difference |= expected.charAt(a) ^ value.charAt(a);
+        }
+        return difference == 0;
+    }
+
+    private final class CarrierWebViewClient extends WebViewClient {
+
+        private final int carrierGeneration;
+        private final String allowedOrigin;
+        private final String canonicalUrl;
+
+        private CarrierWebViewClient(int carrierGeneration, String allowedOrigin, String canonicalUrl) {
+            this.carrierGeneration = carrierGeneration;
+            this.allowedOrigin = allowedOrigin;
+            this.canonicalUrl = canonicalUrl;
+        }
+
+        @Override
+        public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+            // Only the one canonical nonce bearing bridge URL may become the main frame.
+            return !(request.isForMainFrame() && canonicalUrl.equals(request.getUrl().toString()));
+        }
+
+        @Override
+        public boolean shouldOverrideUrlLoading(WebView view, String url) {
+            return !canonicalUrl.equals(url);
+        }
+
+        @Override
+        public WebResourceResponse shouldInterceptRequest(WebView view, WebResourceRequest request) {
+            if (isAllowedRequest(request.getUrl())) {
+                return null;
+            }
+            return blockedResponse();
+        }
+
+        @Override
+        public WebResourceResponse shouldInterceptRequest(WebView view, String url) {
+            if (isAllowedRequest(Uri.parse(url))) {
+                return null;
+            }
+            return blockedResponse();
+        }
+
+        private boolean isAllowedRequest(Uri uri) {
+            if (uri == null) {
+                return false;
+            }
+            String scheme = uri.getScheme();
+            if (scheme == null) {
+                return false;
+            }
+            scheme = scheme.toLowerCase(Locale.US);
+            if (!"https".equals(scheme) && !"wss".equals(scheme)) {
+                return false;
+            }
+            if (uri.getUserInfo() != null) {
+                return false;
+            }
+            int port = uri.getPort();
+            if (port != -1 && port != 443) {
+                return false;
+            }
+            String host = uri.getHost();
+            return host != null && allowedOrigin.equals("https://" + host.toLowerCase(Locale.US));
+        }
+
+        private WebResourceResponse blockedResponse() {
+            Map<String, String> headers = Collections.emptyMap();
+            WebResourceResponse response = new WebResourceResponse("text/plain", "utf-8", new ByteArrayInputStream(new byte[0]));
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
+                response.setStatusCodeAndReasonPhrase(403, "Forbidden");
+                response.setResponseHeaders(headers);
+            }
+            return response;
+        }
+
+        @Override
+        public void onReceivedSslError(WebView view, SslErrorHandler handler, android.net.http.SslError error) {
+            handler.cancel();
+            failCarrier("tls error on the bridge origin");
+        }
+
+        @Override
+        public void onReceivedError(WebView view, WebResourceRequest request, android.webkit.WebResourceError error) {
+            if (request.isForMainFrame()) {
+                failCarrier("bridge document failed to load");
+            }
+        }
+
+        @Override
+        public boolean onRenderProcessGone(WebView view, RenderProcessGoneDetail detail) {
+            synchronized (lock) {
+                if (webView != view) {
+                    return true;
+                }
+                webView = null;
+            }
+            try {
+                view.destroy();
+            } catch (Throwable ignore) {
+            }
+            failCarrier("webview renderer terminated");
+            return true;
+        }
+    }
+
+    private final class CarrierWebChromeClient extends WebChromeClient {
+
+        @Override
+        public boolean onCreateWindow(WebView view, boolean isDialog, boolean isUserGesture, android.os.Message resultMsg) {
+            return false;
