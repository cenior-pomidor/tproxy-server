@@ -0,0 +1,247 @@
+/*
+ * This is the source code of Telegram for Android v. 5.x.x.
+ * It is licensed under GNU GPL v. 2 or later.
+ * You should have received a copy of the license in this archive (see LICENSE).
+ *
+ * Canonical WEB proxy hostname, secret, capability and link handling.
+ * See PROTOCOL.md and ANDROID.md of the relay project.
+ */
+
+package org.telegram.messenger;
+
+import android.text.TextUtils;
+import android.util.Base64;
+
+import java.io.UnsupportedEncodingException;
+import java.net.IDN;
+import java.net.URLDecoder;
+import java.net.URLEncoder;
+import java.util.Locale;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+public final class WebProxyLink {
+
+    /** Frozen v1 domain separation label, it is not restricted to Telegram Desktop. */
+    private static final String CAPABILITY_CONTEXT = "tdesktop-web-proxy-bridge-v1\n";
+
+    /** WEB always uses HTTPS on 443, the port is never part of the link. */
+    public static final int PORT = 443;
+
+    public final String hostname;
+    public final String secret;
+
+    private WebProxyLink(String hostname, String secret) {
+        this.hostname = hostname;
+        this.secret = secret;
+    }
+
+    /**
+     * Canonical lowercase ASCII/IDNA A-label hostname, mirroring the relay's ValidateHostname.
+     */
+    public static boolean isValidHostname(String host) {
+        if (TextUtils.isEmpty(host) || host.length() > 253 || host.endsWith(".")) {
+            return false;
+        }
+        if (host.indexOf('.') < 0) {
+            return false;
+        }
+        for (int a = 0; a < host.length(); a++) {
+            char character = host.charAt(a);
+            if (character > 127) {
+                return false;
+            }
+            if (":/@?#[]".indexOf(character) >= 0) {
+                return false;
+            }
+        }
+        String[] labels = host.split("\\.", -1);
+        boolean numericOnly = true;
+        for (int a = 0; a < labels.length; a++) {
+            String label = labels[a];
+            if (label.length() == 0 || label.length() > 63 || label.charAt(0) == '-' || label.charAt(label.length() - 1) == '-') {
+                return false;
+            }
+            for (int b = 0; b < label.length(); b++) {
+                char character = label.charAt(b);
+                boolean digit = character >= '0' && character <= '9';
+                if (!digit && (character < 'a' || character > 'z') && character != '-') {
+                    return false;
+                }
+                if (!digit) {
+                    numericOnly = false;
+                }
+            }
+        }
+        // A dotted quad is an IP address literal, not a DNS hostname.
+        return !(numericOnly && labels.length == 4);
+    }
+
+    /**
+     * Decodes a client facing MTProxy secret into the 16 bytes, or 17 bytes with the leading
+     * {@code dd} random padding marker, that key the bridge capability.
+     */
+    public static byte[] decodeSecret(String value) {
+        if (value == null) {
+            return null;
+        }
+        value = value.trim();
+        byte[] decoded = null;
+        if (value.length() == 32 || value.length() == 34) {
+            decoded = decodeHex(value);
+        }
+        if (decoded == null) {
+            decoded = decodeBase64(value, Base64.URL_SAFE);
+        }
+        if (decoded == null) {
+            decoded = decodeBase64(value, Base64.DEFAULT);
+        }
+        if (decoded == null || (decoded.length != 16 && decoded.length != 17)) {
+            return null;
+        }
+        if (decoded.length == 17 && (decoded[0] & 0xff) != 0xdd) {
+            return null;
+        }
+        return decoded;
+    }
+
+    public static boolean isValidSecret(String value) {
+        return decodeSecret(value) != null;
+    }
+
+    private static byte[] decodeHex(String value) {
+        byte[] result = new byte[value.length() / 2];
+        for (int a = 0; a < result.length; a++) {
+            int high = Character.digit(value.charAt(a * 2), 16);
+            int low = Character.digit(value.charAt(a * 2 + 1), 16);
+            if (high < 0 || low < 0) {
+                return null;
+            }
+            result[a] = (byte) ((high << 4) | low);
+        }
+        return result;
+    }
+
+    private static byte[] decodeBase64(String value, int flags) {
+        try {
+            return Base64.decode(value, flags | Base64.NO_WRAP);
+        } catch (Exception ignore) {
+            return null;
+        }
+    }
+
+    /**
+     * base64url-no-padding(HMAC-SHA256(key = secret bytes, message = context + hostname)).
+     */
+    public static String capability(String hostname, byte[] secret) {
+        try {
+            Mac mac = Mac.getInstance("HmacSHA256");
+            mac.init(new SecretKeySpec(secret, "HmacSHA256"));
+            byte[] digest = mac.doFinal((CAPABILITY_CONTEXT + hostname).getBytes("UTF-8"));
+            return Base64.encodeToString(digest, Base64.URL_SAFE | Base64.NO_PADDING | Base64.NO_WRAP);
+        } catch (Exception e) {
+            FileLog.e(e);
+            return null;
+        }
+    }
+
+    public static String bridgeUrl(String hostname, String capability, String nonce) {
+        return "https://" + hostname + "/?bridge=" + capability + "#android=" + nonce;
+    }
+
+    public static String origin(String hostname) {
+        return "https://" + hostname;
+    }
+
+    public static String buildLink(String hostname, String secret) {
+        try {
+            return "https://t.me/webproxy?server=" + URLEncoder.encode(hostname, "UTF-8")
+                    + "&secret=" + URLEncoder.encode(secret, "UTF-8");
+        } catch (UnsupportedEncodingException ignore) {
+            return "https://t.me/webproxy?server=" + hostname + "&secret=" + secret;
+        }
+    }
+
+    /**
+     * Accepts {@code https://t.me/webproxy?...}, {@code tg://webproxy?...} and the {@code host}
+     * legacy input alias. Returns null when the link is not a canonical WEB proxy link.
+     */
+    public static WebProxyLink parse(String url) {
+        if (TextUtils.isEmpty(url)) {
+            return null;
+        }
+        String query = null;
+        String lower = url.toLowerCase(Locale.US);
+        final String[] prefixes = {"t.me/webproxy?", "tg://webproxy?", "telegram.me/webproxy?", "telegram.dog/webproxy?"};
+        for (int a = 0; a < prefixes.length; a++) {
+            int index = lower.indexOf(prefixes[a]);
+            if (index >= 0) {
+                query = url.substring(index + prefixes[a].length());
+                break;
+            }
+        }
+        if (query == null) {
+            return null;
+        }
+        int cut = query.indexOf('#');
+        if (cut >= 0) {
+            query = query.substring(0, cut);
+        }
+        return fromQuery(query);
+    }
+
+    public static WebProxyLink fromQuery(String query) {
+        String hostname = null;
+        String secret = null;
+        String[] parts = query.split("&");
+        for (int a = 0; a < parts.length; a++) {
+            int equals = parts[a].indexOf('=');
+            if (equals <= 0) {
+                continue;
+            }
+            String key = parts[a].substring(0, equals).toLowerCase(Locale.US);
+            String value = decodeComponent(parts[a].substring(equals + 1));
+            if ("server".equals(key) || ("host".equals(key) && hostname == null)) {
+                hostname = value;
+            } else if ("secret".equals(key)) {
+                secret = value;
+            }
+        }
+        return from(hostname, secret);
+    }
+
+    public static WebProxyLink from(String hostname, String secret) {
+        if (hostname == null || secret == null) {
+            return null;
+        }
+        hostname = hostname.trim().toLowerCase(Locale.US);
+        secret = secret.trim();
+        boolean unicode = false;
+        for (int a = 0; a < hostname.length(); a++) {
+            if (hostname.charAt(a) > 127) {
+                unicode = true;
+                break;
+            }
+        }
+        if (unicode) {
+            try {
+                hostname = IDN.toASCII(hostname, IDN.ALLOW_UNASSIGNED).toLowerCase(Locale.US);
+            } catch (Exception ignore) {
+                return null;
+            }
+        }
+        if (!isValidHostname(hostname) || !isValidSecret(secret)) {
+            return null;
+        }
+        return new WebProxyLink(hostname, secret);
+    }
+
+    private static String decodeComponent(String value) {
+        try {
+            return URLDecoder.decode(value, "UTF-8");
+        } catch (Exception ignore) {
+            return value;
+        }
+    }
+}
